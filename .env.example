# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/modu_pro

# Authentication & Security Secrets (Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=replace_with_a_64_byte_cryptographic_secret_in_production
JWT_EXPIRES_IN=12h
CSRF_SECRET=replace_with_a_32_byte_csrf_secret_in_production

# Initial Admin Provisioning (Used ONLY by scripts/createAdmin.js, never exposed at runtime)
INITIAL_ADMIN_NAME=Modu Pro Administrator
INITIAL_ADMIN_EMAIL=admin@modupro.in
INITIAL_ADMIN_PASSWORD=

# Optional Cloudinary Media Storage (Falls back to local /uploads if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional SMTP / Nodemailer Configuration for Enquiry Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Modu Pro Innovation <no-reply@modupro.in>"
ENQUIRY_NOTIFICATION_EMAIL=moduproinnovations2805@gmail.com
